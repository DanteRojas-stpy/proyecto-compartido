# Mismo formato de fin de línea para todos (evita cambios falsos entre IAs)
* text=auto eol=lf

# Archivos de Windows que necesitan CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Archivos binarios
*.xlsx binary
*.xlsm binary
*.xls  binary
*.docx binary
*.pdf  binary
*.dwg  binary
*.png  binary
*.jpg  binary
