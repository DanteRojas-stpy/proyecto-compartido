# Copia este archivo como deploy/nube.env y complétalo. deploy/nube.env no se sube a Git.
# Clave interna: la MISMA que registraste en Nhost (E3_INTERNAL_KEY) y en la credencial «CostFlow E3 - Acceso interno» de n8n.
E3_INTERNAL_KEY=
NHOST_SUBDOMAIN=
NHOST_REGION=sa-east-1
# Dirección de tu n8n en la nube, sin barra final. Ejemplo: https://miempresa.app.n8n.cloud
N8N_URL=
# Tres nombres de dominio que apunten (registro A) a la IP del servidor.
DOMINIO_E3=e3.ejemplo.com
DOMINIO_E4=e4.ejemplo.com
DOMINIO_E5=e5.ejemplo.com
