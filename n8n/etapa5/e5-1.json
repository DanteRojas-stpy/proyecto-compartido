      ],
      "notes": "CREDENCIAL_E4:internal"
    },
    {
      "id": "1b941427-0112-5b5f-b16d-5e90a2e0fc89",
      "name": "Evaluar cuadro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// El servicio devuelve el xlsx y su validación; un cuadro imposible de armar no se reintenta.\nconst ctx = $('Armar petición').first().json;\nconst base = { cuadro_id: ctx.cuadro_id, token: ctx.token };\nif (!$json.ok || !$json.archivo_b64) {\n  return [{ json: { ...base, ok: false, recuperable: $json.recuperable !== false,\n    error: String($json.error ?? $json.detail ?? 'El servicio de E5 no devolvió el cuadro.').slice(0, 600) } }];\n}\nconst nombre = `cuadro-${ctx.codigo}-rev${ctx.revision}.xlsx`;\nconst binario = await this.helpers.prepareBinaryData(Buffer.from($json.archivo_b64, 'base64'), nombre,\n  'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');\nreturn [{ json: { ...base, ok: true, estado: $json.estado, validacion: $json.validacion, nombre_archivo: nombre,\n  metadata: JSON.stringify({ name: nombre, metadata: { tipo: 'cuadro_comparativo', cuadro_id: ctx.cuadro_id } }) }, binary: { data: binario } }];"
      },
      "position": [
        1980,
        0
      ]
    },
