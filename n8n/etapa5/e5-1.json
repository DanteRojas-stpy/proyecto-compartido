      "name": "Descargar plantilla",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://SUBDOMINIO.storage.REGION.nhost.run/v1/files/' + $json.storage_file_id }}",
