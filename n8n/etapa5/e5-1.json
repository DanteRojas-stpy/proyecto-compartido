    {
      "id": "7fd99a0b-97af-589f-81fb-ec351328b154",
      "name": "Armar petición",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Une la plantilla descargada con la homologación y el tipo de cambio para el servicio de E5.\nconst ctx = $('Comprobar entrada').first().json;\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst e = ctx.entrada;\nreturn [{ json: { cuadro_id: ctx.cuadro_id, token: ctx.token, codigo: e.solicitud?.codigo ?? 'solicitud', revision: e.revision,\n  peticion: { homologacion: e.homologacion, tipo_cambio: e.tipo_cambio ?? null, plantilla_b64: buffer.toString('base64') } } }];"
      },
      "position": [
        1540,
        0
      ]
    },
    {
      "id": "866c9e49-ee1d-5490-b5b6-b9c301a5ea33",
      "name": "Generar cuadro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://costflow-cuadro:8095/e5/generar",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.peticion) }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "position": [
