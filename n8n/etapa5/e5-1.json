      "name": "Evaluar subida",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Storage responde con el archivo creado; sin identificador, el intento falla y se reintenta.\nconst ctx = $('Evaluar cuadro').first().json;\nconst base = { cuadro_id: ctx.cuadro_id, token: ctx.token };\nconst id = $json.processedFiles?.[0]?.id;\nif (!id) return [{ json: { ...base, ok: false, recuperable: true, error: 'Storage no guardó el cuadro: ' + JSON.stringify($json).slice(0, 300) } }];\nreturn [{ json: { ...base, ok: true, estado: ctx.estado, validacion: ctx.validacion, nombre_archivo: ctx.nombre_archivo, storage_file_id: id } }];"
