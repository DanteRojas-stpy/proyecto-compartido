    {
      "id": "6f2b7f40-cb6b-5c05-8156-3a9e43073888",
      "name": "Comprobar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Sigue solo si Nhost entregó la entrada de este cuadro; si el intento venció, termina sin hacer nada.\nconst tomada = $('Tomar cuadro pendiente').first().json.respuesta;\nconst entrada = $json.respuesta;\nif (entrada?.resultado !== 'entrada') return [];\nconst base = { cuadro_id: tomada.cuadro_id, token: tomada.token, entrada };\nif (!entrada.plantilla?.storage_file_id) {\n  return [{ json: { ...base, ok: false, recuperable: false, error: 'La solicitud no tiene cargada la plantilla del cuadro comparativo.' } }];\n}\nreturn [{ json: { ...base, ok: true, storage_file_id: entrada.plantilla.storage_file_id } }];"
      },
      "position": [
        880,
        0
      ]
    },
    {
      "id": "0b245e7e-834f-5b75-9104-4e1ef5906549",
