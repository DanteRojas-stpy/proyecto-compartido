      ]
    },
    {
      "id": "58f83159-e632-551f-ba29-a5bd94b4c83c",
      "name": "Convertir a Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Traduce la petición del lector (formato interno del lector) al formato de la API de mensajes de Claude.\nconst { modelo, peticion } = $json;\nconst partes = (x) => (x?.parts ?? []).map((p) => p.text ?? '').join('\\n');\nconst sistema = partes(peticion.systemInstruction);\nconst contenido = (peticion.contents ?? []).map((c) => partes(c)).join('\\n');\nconst esquema = peticion.generationConfig?.responseJsonSchema ?? {};\nif (!contenido.trim()) throw new Error('La petición no trae contenido para leer');\nconst instruccion = sistema\n  + '\\n\\nResponde únicamente con un objeto JSON válido que cumpla exactamente este esquema JSON. '\n  + 'Sin texto adicional, sin comentarios y sin bloques de código:\\n' + JSON.stringify(esquema);\nconst cuerpo = {\n  model: modelo,\n  max_tokens: 16000,\n  system: instruccion,\n  messages: [{ role: 'user', content: contenido }],\n};\n// Extraer datos no necesita razonar a fondo: el esfuerzo bajo deja los tokens para el JSON (modelos 5.x).\nif (/^claude-(opus|sonnet|haiku)-5/.test(modelo)) cuerpo.output_config = { effort: 'low' };\nreturn [{ json: { modelo, cuerpo } }];"
      },
      "position": [
        1320,
        0
      ]
    },
    {
      "id": "c1742b9b-7951-54bf-b813-23f6596e3193",
      "name": "Claude Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.cuerpo) }}",
        "options": {
          "timeout": 170000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "position": [
        1540,
        0
      ],
      "notes": "CREDENCIAL_E3:claude"
    },
    {
      "id": "a74f633c-812e-5d76-be1c-251ba1c57ba5",
      "name": "Claude a formato del lector",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Devuelve la respuesta de Claude con la forma que espera el lector.\nconst r = $json;\nconst rechazo = (mensaje) => [{ json: { error: { message: mensaje } } }];\nif (r.type === 'error' || r.error) return rechazo('Claude rechazó la petición: ' + (r.error?.message ?? 'error sin detalle'));\nif (r.stop_reason === 'refusal') return rechazo('Claude rechazó la petición por seguridad.');\nconst texto = (r.content ?? []).filter((b) => b.type === 'text').map((b) => b.text).join('').trim();\nlet limpio = texto.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '');\nconst ini = limpio.indexOf('{');\nconst fin = limpio.lastIndexOf('}');\nif (ini >= 0 && fin > ini) limpio = limpio.slice(ini, fin + 1);\nconst completo = r.stop_reason === 'end_turn' || r.stop_reason === 'stop_sequence';\nif (!completo) return rechazo('Claude no devolvió una respuesta completa (' + (r.stop_reason ?? 'sin motivo') + '; salida: ' + (r.usage?.output_tokens ?? '?') + ' tokens).');\nreturn [{ json: {\n  candidates: [{ finishReason: 'STOP', content: { parts: [{ text: limpio }] } }],\n  usageMetadata: { promptTokenCount: r.usage?.input_tokens, candidatesTokenCount: r.usage?.output_tokens },\n  modelVersion: r.model,\n} }];"
      },
      "position": [
        1760,
        0
      ]
    },
