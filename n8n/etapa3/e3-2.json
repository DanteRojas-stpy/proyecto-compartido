    {
      "id": "e302a0c9-56d3-59e1-bf7d-9e6f0df27216",
      "name": "Preparar petición estructurada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "if(!/^claude-[a-zA-Z0-9.-]+$/.test($json.body.modelo??''))throw new Error('El modelo debe ser de Claude (claude-...)');return [{json:$json.body}];"
      },
