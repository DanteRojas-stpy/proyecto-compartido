    {
      "id": "d67fbbba-faaf-57ef-b3ac-5bf035eb198d",
      "name": "Preparar decisión",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// --- E3.4/E3.5 · «Preparar decisión»: valida el origen, la sesión y la forma de la petición del frontend. La identidad real la verifica Nhost Auth.\nconst r = $json;\nconst origen = String(r.headers?.origin ?? '');\nconst origenes = ['http://127.0.0.1:8001', 'http://localhost:8001'];\nif (origen && !origenes.includes(origen)) return [{ json: { ok: false, http_code: 403, mensaje: 'Origen de frontend no autorizado.' } }];\nif (!/^Bearer\\s+\\S+$/i.test(String(r.headers?.authorization ?? ''))) return [{ json: { ok: false, http_code: 401, mensaje: 'Inicia sesión en Nhost.' } }];\nif (!r.body || typeof r.body !== 'object' || Array.isArray(r.body)) return [{ json: { ok: false, http_code: 400, mensaje: 'Envía una decisión en JSON.' } }];\nreturn [{ json: { ok: true, body: r.body, authorization: r.headers.authorization } }];\n"
      },
      "position": [
        220,
        0
      ]
    },
