      "name": "Entregar documento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// --- E3.4 · «Entregar documento»: el original, en base64, para que el frontend lo muestre.\nconst permiso = $('Documento permitido').first().json;\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nreturn [{ json: { ok: true, http_code: 200, nombre: permiso.nombre_original, mime_type: permiso.mime_type, contenido_base64: buffer.toString('base64') } }];\n"
      },
