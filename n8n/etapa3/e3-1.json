    {
      "id": "597b7ced-3ea5-5b19-9c0d-0a926b732646",
      "name": "Preparar todos los adjuntos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const result=[];\nfor(let index=0;index<$input.all().length;index++){\nconst item=$input.all()[index];const contexto=$('Resultado de recepción').itemMatching(index).json;\nconst archivos=[];for(const[key,b]of Object.entries(item.binary??{})){const bytes=await this.helpers.getBinaryDataBuffer(index,key);\narchivos.push({nombre_original:b.fileName??key,mime_type:b.mimeType??'application/octet-stream',contenido_base64:bytes.toString('base64')});}\nresult.push({json:{contexto,archivos,error:item.json.error??null},pairedItem:{item:index}});}return result;"
      },
      "position": [
        1760,
        0
      ]
    },
