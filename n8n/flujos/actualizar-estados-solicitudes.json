          "id": "REEMPLAZAR_NHOST",
          "name": "Nhost Admin"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const datos = $json.data;\nif (!datos) throw new Error('Nhost no devolvió datos para revisar los vencimientos.');\nconst conProveedor = new Set([\n  ...(datos.solicitud_proveedores ?? []).map((item) => item.solicitud_id),\n  ...(datos.documentos ?? []).map((item) => item.solicitud_id),\n]);\nreturn (datos.solicitudes_cotizacion ?? [])\n  .filter((solicitud) => !conProveedor.has(solicitud.id))\n  .map((solicitud) => ({ json: solicitud }));"
      },
