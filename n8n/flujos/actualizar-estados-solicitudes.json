        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { query: \"query SolicitudesVencidas($hoy: date!) {\\n  solicitudes_cotizacion(where: { estado: { _eq: \\\"inicio\\\" }, fecha_limite: { _lt: $hoy } }) { id codigo }\\n  solicitud_proveedores(where: { estado_respuesta: { _in: [\\\"envio_cotizacion\\\", \\\"envio_cotizacion_con_aclaracion\\\"] } }) { solicitud_id }\\n  documentos(where: { tipo: { _eq: \\\"cotizacion_proveedor\\\" }, documento_estado: { _eq: \\\"vigente\\\" } }) { solicitud_id }\\n}\", variables: { hoy: $now.setZone('America/Lima').toISODate() } } }}",
        "options": {}
