{
  "name": "E4: homologación desde el contrato de E3 (Gemini 3.5 Flash-Lite)",
  "nodes": [
    {
      "id": "revisar-homologación",
      "name": "Revisar homologación",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "configurar-solicitud",
      "name": "Configurar solicitud",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "sol",
              "name": "solicitud_id",
              "value": "REEMPLAZAR_UUID_SOLICITUD",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "consultar-finales,-itemizado-y-proveedor",
      "name": "Consultar finales, itemizado y proveedores",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "REEMPLAZAR_URL_GRAPHQL_NHOST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { query: \"query ContextoE4($solicitud: uuid!) {\\n  e3_finales_e4(where: {solicitud_id: {_eq: $solicitud}}) {\\n    proveedor_id version_id correo_id numero_version resultado\\n  }\\n  partidas(where: {solicitud_id: {_eq: $solicitud}}, order_by: {orden: asc}) {\\n    codigo descripcion unidad metrado\\n  }\\n  solicitud_proveedores(where: {solicitud_id: {_eq: $solicitud}}) {\\n    proveedor_id estado\\n  }\\n}\", variables: { solicitud: $json.solicitud_id } } }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_credencial_nhost",
          "name": "Nhost Admin"
        }
      }
    },
    {
      "id": "separar-finales-y-pendientes",
      "name": "Separar finales y pendientes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "const data = $input.first().json.data ?? $input.first().json;\nconst finales = data.e3_finales_e4 ?? [];\nconst partidas = data.partidas ?? [];\nconst participantes = (data.solicitud_proveedores ?? []).filter(p => p.estado === 'respondio');\nconst conFinal = new Set(finales.map(f => f.proveedor_id));\nconst pendientes = participantes\n  .filter(p => !conFinal.has(p.proveedor_id))\n  .map(p => ({ proveedor_id: p.proveedor_id, estado: 'pendiente_insumo_final',\n    motivo: 'Respondió, pero no tiene una versión final procesada en E3.' }));\nreturn [{ json: {\n  solicitud_id: $('Configurar solicitud').first().json.solicitud_id,\n  finales, partidas, pendientes } }];"
      }
    },
    {
      "id": "¿hay-versiones-finales?",
      "name": "¿Hay versiones finales?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "hay",
              "leftValue": "={{ $json.finales.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "preparar-entrada-para-el-modelo",
      "name": "Preparar entrada para el modelo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        220
      ],
      "parameters": {
        "jsCode": "const base = $input.first().json;\nconst finales = base.finales.map(f => ({\n  proveedor_id: f.proveedor_id, version_id: f.version_id,\n  correo_id: f.correo_id, numero_version: f.numero_version, resultado: f.resultado }));\nconst peticion = 'Itemizado: ' + JSON.stringify(base.partidas) +\n  '\\nVersiones finales (usa solo resultado): ' + JSON.stringify(finales);\nreturn [{ json: { peticion, finales, pendientes: base.pendientes, solicitud_id: base.solicitud_id } }];"
      }
    },
    {
      "id": "proponer-homologación-con-gemini",
      "name": "Proponer homologación con Gemini",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1320,
        220
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.peticion }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Eres un asistente de homologación de cotizaciones de obra. Recibes solo datos ya estructurados de cada versión final (campo resultado) y el itemizado. No lees documentos. Relaciona cada ítem con la partida por código o descripción comprobable. Si un dato no está en el resultado, devuelve null. Nunca asumas equivalencias técnicas: márcalas con requiere_revision=true y explica el motivo en observaciones. Cita en cada ítem el version_id de origen."
            }
          ]
        }
      }
    },
    {
      "id": "modelo-gemini-3.8-flash",
      "name": "Modelo Gemini 3.5 Flash-Lite",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        1320,
        420
      ],
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": "REEMPLAZAR_credencial_gemini",
          "name": "Gemini CostFlow"
        }
      }
    },
    {
      "id": "formato-de-propuesta",
      "name": "Formato de propuesta",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1320,
        600
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"items\", \"observaciones\"], \"properties\": {\"items\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"required\": [\"proveedor_id\", \"version_id\", \"partida_codigo\", \"descripcion\", \"unidad\", \"cantidad\", \"precio_unitario\", \"moneda\", \"evidencia\", \"requiere_revision\"], \"properties\": {\"proveedor_id\": {\"type\": \"string\"}, \"version_id\": {\"type\": \"string\"}, \"partida_codigo\": {\"type\": [\"string\", \"null\"]}, \"descripcion\": {\"type\": \"string\"}, \"unidad\": {\"type\": [\"string\", \"null\"]}, \"cantidad\": {\"type\": [\"number\", \"null\"]}, \"precio_unitario\": {\"type\": [\"number\", \"null\"]}, \"moneda\": {\"type\": [\"string\", \"null\"]}, \"evidencia\": {\"type\": [\"string\", \"null\"]}, \"requiere_revision\": {\"type\": \"boolean\"}}}}, \"observaciones\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}}"
      }
    },
    {
      "id": "validar-y-registrar-version_id",
      "name": "Validar y registrar version_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        220
      ],
      "parameters": {
        "jsCode": "const salida = $input.first().json.output ?? $input.first().json;\nconst previo = $('Preparar entrada para el modelo').first().json;\nconst versiones = new Map(previo.finales.map(f => [f.proveedor_id, f.version_id]));\nconst propuestas = (salida.items ?? []).filter(it => versiones.has(it.proveedor_id) &&\n  it.version_id === versiones.get(it.proveedor_id));\nconst descartadas = (salida.items ?? []).length - propuestas.length;\nconst observaciones = [...(salida.observaciones ?? [])];\nif (descartadas > 0) observaciones.push(descartadas + ' propuesta(s) sin version_id válido se descartaron.');\nreturn [{ json: { solicitud_id: previo.solicitud_id, propuestas, pendientes: previo.pendientes, observaciones } }];"
      }
    },
    {
      "id": "entregar-homologación-para-revisión",
      "name": "Entregar homologación para revisión",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        220
      ],
      "parameters": {
        "jsCode": "const v = $input.first().json;\nreturn [{ json: {\n  solicitud_id: v.solicitud_id,\n  estado: v.pendientes.length ? 'parcial_pendiente_insumos' : 'pendiente_revision',\n  propuestas: v.propuestas,\n  pendientes: v.pendientes,\n  observaciones: v.observaciones,\n  nota: 'Persistencia en Nhost pendiente: requiere la tabla de propuestas de homologación (migración 010).' } }];"
      }
    },
    {
      "id": "pendiente-de-insumos-finales",
      "name": "Pendiente de insumos finales",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1100,
        420
      ],
      "parameters": {}
    },
    {
      "id": "alcance-de-este-flujo",
      "name": "Alcance de este flujo",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        60
      ],
      "parameters": {
        "content": "## E4 homologación (contrato de E3)\nLee solo `e3_finales_e4`: nunca PDF ni Excel. Cada propuesta lleva el `version_id` de origen. Un proveedor sin versión final procesada queda pendiente y no se homologa. Modelo: Gemini 3.5 Flash-Lite. Sin escritura en Nhost todavía."
      }
    }
  ],
