    {
      "parameters": {
        "jsCode": "const p = $('Parámetros y base de la plantilla').first().json;\nconst BASE_METRADO = Number(p.base_metrado);\nconst BASE_COSTO = Number(p.base_costo_unitario_s);\nconst PRESUPUESTO_BASE = BASE_METRADO * BASE_COSTO;\nconst TC = p.tipo_cambio === null || p.tipo_cambio === undefined || p.tipo_cambio === '' ? null : Number(p.tipo_cambio);\n\nconst filas = $input.all().map(i => i.json).filter(r => r.Proveedor);\n\nreturn filas.map(r => {\n  const precio = Number(r.Precio_unitario) || null;\n  const cantidad = Number(r.Cantidad) || null;\n  const moneda = String(r.Moneda || '').toUpperCase();\n  const estado = [];\n  let precioPen = null;\n\n  if (precio === null) estado.push('sin_precio');\n  if (moneda === 'USD') {\n    if (TC) precioPen = precio * TC; else estado.push('pendiente_tipo_cambio');\n  } else if (moneda === 'PEN') {\n    precioPen = precio;\n  } else {\n    estado.push('moneda_no_indicada');\n  }\n\n  if (cantidad === null) estado.push('pendiente_cantidad');\n  else if (cantidad !== BASE_METRADO) estado.push('metrado_distinto_de_base');\n\n  const desvUnit = precioPen === null ? null : (precioPen - BASE_COSTO) / BASE_COSTO;\n  if (desvUnit !== null && Math.abs(desvUnit) > 0.5) estado.push('revisar_moneda_o_precio');\n\n  const parcial = precioPen !== null && cantidad !== null ? precioPen * cantidad : null;\n\n  return {\n    archivo: r.archivo,\n    Proveedor: r.Proveedor,\n    Descripcion: r.Descripcion,\n    Moneda: moneda || null,\n    Precio_original: precio,\n    Cantidad: cantidad,\n    Precio_unitario_S: precioPen === null ? null : Math.round(precioPen * 100) / 100,\n    Costo_base_unitario_S: BASE_COSTO,\n    Desviacion_unitaria_pct: desvUnit === null ? null : Math.round(desvUnit * 10000) / 100,\n    Parcial_S: parcial === null ? null : Math.round(parcial * 100) / 100,\n    Presupuesto_base_S: PRESUPUESTO_BASE,\n    Estado: estado.length ? estado.join(';') : 'comparable'\n  };\n});"
      },
