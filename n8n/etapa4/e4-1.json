      ],
      "notes": "CREDENCIAL_E4:internal"
    },
    {
      "id": "8a696a6f-e0fa-5e46-87d1-a3b386e68a63",
      "name": "Verificar petición",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// El servicio de homologación debe devolver la petición lista para Claude.\nconst ctx = $('Comprobar entrada').first().json;\nconst base = { ejecucion_id: ctx.ejecucion_id, token: ctx.token, paquete: ctx.paquete };\nif (!$json.cuerpo_claude) {\n  return [{ json: { ...base, ok: false, error: 'El servicio de homologación no preparó la petición: ' + String($json.detail ?? $json.error ?? 'sin detalle').slice(0, 300) } }];\n}\nreturn [{ json: { ...base, ok: true, cuerpo_claude: $json.cuerpo_claude, modelo: $json.modelo } }];"
      },
      "position": [
        1320,
        0
      ]
    },
