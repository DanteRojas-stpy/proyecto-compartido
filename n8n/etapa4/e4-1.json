    {
      "id": "96d8fc5f-6c8e-56c2-a050-1c701d444cd2",
      "name": "Comprobar entrada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Sigue solo si Nhost entregó la entrada de esta homologación; si el intento venció, termina sin hacer nada.\nconst tomada = $('Tomar homologación pendiente').first().json.respuesta;\nconst entrada = $json.respuesta;\nif (entrada?.resultado !== 'entrada') return [];\nreturn [{ json: { ejecucion_id: tomada.ejecucion_id, token: tomada.token, paquete: entrada.paquete } }];"
      },
      "position": [
        880,
        0
      ]
    },
    {
      "id": "07e9d4a5-21ea-544d-980d-ff665db26e8b",
      "name": "Preparar petición para Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://costflow-homologacion:8094/e4/preparar",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({paquete:$json.paquete}) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "position": [
        1100,
