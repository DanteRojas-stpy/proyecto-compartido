        0
      ],
      "notes": "CREDENCIAL_E4:claude"
    },
    {
      "id": "147b1ab0-98e2-5f3f-a8d1-957b259bc183",
      "name": "Interpretar respuesta de Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Convierte la respuesta de la API de Claude en texto utilizable o en un fallo con su motivo.\nconst ctx = $('Verificar petición').first().json;\nconst base = { ejecucion_id: ctx.ejecucion_id, token: ctx.token, paquete: ctx.paquete };\nconst r = $json;\nconst fallo = (mensaje) => [{ json: { ...base, ok: false, error: mensaje } }];\nif (r.type === 'error' || r.error) return fallo('Claude rechazó la petición: ' + (r.error?.message ?? 'error sin detalle'));\nif (r.stop_reason === 'refusal') return fallo('Claude rechazó la petición por seguridad.');\nif (r.stop_reason !== 'end_turn') return fallo('Claude no terminó la respuesta (' + (r.stop_reason ?? 'sin motivo') + '; salida: ' + (r.usage?.output_tokens ?? '?') + ' tokens).');\nconst texto = (r.content ?? []).filter((b) => b.type === 'text').map((b) => b.text).join('');\nreturn [{ json: { ...base, ok: true, texto, modelo: r.model ?? ctx.modelo,\n  tokens_entrada: r.usage?.input_tokens ?? null, tokens_salida: r.usage?.output_tokens ?? null } }];"
      },
      "position": [
        1980,
        0
      ]
    },
