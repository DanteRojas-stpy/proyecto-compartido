    {
      "id": "79ecb6a1-1f0a-5ef5-a57b-cfd67226e3cf",
      "name": "Evaluar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// El servicio valida la respuesta contra la entrada; si no cuadra, es un fallo reintentable.\nconst ctx = $('Interpretar respuesta de Claude').first().json;\nconst base = { ejecucion_id: ctx.ejecucion_id, token: ctx.token, paquete: ctx.paquete };\nif ($json.resultado !== 'construida') {\n  const errores = Array.isArray($json.errores) ? $json.errores.join('; ') : String($json.detail ?? $json.error ?? 'sin detalle');\n  return [{ json: { ...base, ok: false, error: 'La respuesta de Claude no pasó la validación: ' + errores.slice(0, 600) } }];\n}\nreturn [{ json: { ...base, ok: true, estado_revision: $json.estado_revision, resultado: $json.homologacion,\n  version_ids: $json.version_ids, huella: $json.huella, modelo: ctx.modelo, tokens_entrada: ctx.tokens_entrada, tokens_salida: ctx.tokens_salida } }];"
      },
